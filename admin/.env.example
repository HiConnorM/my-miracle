# The Worker this console moderates.
MM_API_BASE_URL=http://127.0.0.1:8787

# A staff service token, issued out of band (see admin/README.md).
#
# SERVER-SIDE ONLY. It is read in server components and server actions and never crosses
# to the browser — note the absence of a NEXT_PUBLIC_ prefix, which is what would expose it.
MM_STAFF_TOKEN=mm_staff_replace_me
